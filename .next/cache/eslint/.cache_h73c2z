top/01SHIFT/OR-harmony-next/src/components/ui/date-picker.tsx",[],[],"/Users/ylanebouchenino/Desktop/01SHIFT/OR-harmony-next/src/lib/services/optimized-absences.ts",[],[],"/Users/ylanebouchenino/Desktop/01SHIFT/OR-harmony-next/src/lib/services/smart-assignments.ts",[],[],"/Users/ylanebouchenino/Desktop/01SHIFT/OR-harmony-next/src/app/info/page.tsx",[],[],{"ruleId":"322","severity":1,"message":"323","line":119,"column":9,"nodeType":"324","endLine":133,"endColumn":4,"suggestions":"325"},{"ruleId":"322","severity":1,"message":"326","line":56,"column":6,"nodeType":"327","endLine":56,"endColumn":54,"suggestions":"328"},{"ruleId":"322","severity":1,"message":"326","line":63,"column":6,"nodeType":"327","endLine":63,"endColumn":47,"suggestions":"329"},{"ruleId":"322","severity":1,"message":"330","line":38,"column":6,"nodeType":"327","endLine":38,"endColumn":50,"suggestions":"331","suppressions":"332"},{"ruleId":"322","severity":1,"message":"326","line":39,"column":6,"nodeType":"327","endLine":39,"endColumn":32,"suggestions":"333"},"react-hooks/exhaustive-deps","The 'getAvailableDoctors' function makes the dependencies of useEffect Hook (at line 165) change on every render. To fix this, wrap the definition of 'getAvailableDoctors' in its own useCallback() Hook.","VariableDeclarator",["334"],"React Hook useEffect has a missing dependency: 'loadRecommendations'. Either include it or remove the dependency array.","ArrayExpression",["335"],["336"],"React Hook useEffect has a missing dependency: 'validatePreferences'. Either include it or remove the dependency array.",["337"],["338"],["339"],{"desc":"340","fix":"341"},{"desc":"342","fix":"343"},{"desc":"344","fix":"345"},{"desc":"346","fix":"347"},{"kind":"348","justification":"349"},{"desc":"350","fix":"351"},"Wrap the definition of 'getAvailableDoctors' in its own useCallback() Hook.",{"range":"352","text":"353"},"Update the dependencies array to be: [initialSurgeryType, form.date, form.shift_type, loadRecommendations]",{"range":"354","text":"355"},"Update the dependencies array to be: [surgeryType, form.date, form.shift_type, loadRecommendations]",{"range":"356","text":"357"},"Update the dependencies array to be: [preferences, submitted, showErrorsOnSubmit, validatePreferences]",{"range":"358","text":"359"},"directive","","Update the dependencies array to be: [surgeryType, date, shift, loadRecommendations]",{"range":"360","text":"361"},[5347,6131],"useCallback(async (date: string, shift_type: 'morning' | 'evening') => {\n    // 1. Get all active doctors\n    const allDoctors = await doctorsService.getActive()\n    // 2. Get all approved time off requests for this date\n    const timeOffs = await timeOffRequestsService.getApprovedForDate(date)\n    const unavailableDoctorIds = new Set(timeOffs.map((t: any) => t.doctor_id))\n    // 3. Get all assignments for this date and shift\n    const assignedDoctorIds = new Set(assignments\n      .filter(a => a.date === date && a.shift_type === shift_type)\n      .map(a => a.doctor_id))\n    // 4. Filter out unavailable doctors\n    return allDoctors.filter((doc: any) =>\n      !unavailableDoctorIds.has(doc.id) && !assignedDoctorIds.has(doc.id)\n    ).map((doc: any) => ({ id: doc.id, name: doc.name }))\n  })",[2153,2201],"[initialSurgeryType, form.date, form.shift_type, loadRecommendations]",[2370,2411],"[surgeryType, form.date, form.shift_type, loadRecommendations]",[1495,1539],"[preferences, submitted, showErrorsOnSubmit, validatePreferences]",[1386,1412],"[surgeryType, date, shift, loadRecommendations]"]